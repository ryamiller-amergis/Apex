{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "apex-sdlc-backlog",
  "title": "Apex SDLC Backlog",
  "description": "Structured backlog output produced by the to-prd skill for the Apex platform.",
  "type": "object",
  "required": ["personas", "businessRules", "epics", "implementationPhases", "assumptionsMade"],
  "additionalProperties": false,
  "properties": {
    "personas": {
      "type": "array",
      "description": "Active personas for this PRD. Names must match the Apex groups/roles enum.",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type", "description"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "$ref": "#/definitions/apexPersonaName"
          },
          "type": {
            "type": "string",
            "enum": ["Internal", "Admin", "Technical"]
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "businessRules": {
      "type": "array",
      "description": "Explicit and implied behavioral constraints extracted from the conversation.",
      "items": {
        "type": "object",
        "required": ["id", "rule", "appliesTo"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^BR-[0-9]{3}$",
            "description": "Sequential identifier e.g. BR-001"
          },
          "rule": {
            "type": "string",
            "description": "Precise, unambiguous statement of the constraint."
          },
          "appliesTo": {
            "type": "string",
            "description": "Feature or PBI title this rule governs."
          }
        }
      }
    },
    "epics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "priority", "description", "successMetrics", "outOfScope", "assumptions", "dependencies", "features"],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "priority": {
            "$ref": "#/definitions/moscowPriority"
          },
          "description": {
            "type": "string",
            "description": "Business narrative: problem, value, high-level scope. 2–4 sentences."
          },
          "successMetrics": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "outOfScope": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "assumptions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "dependencies": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "description": "Other Epics, systems, or external factors. Use [\"None\"] if none."
          },
          "features": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/definitions/feature" }
          }
        }
      }
    },
    "assumptionsMade": {
      "type": "array",
      "description": "Must mirror ## Assumptions Made in the PRD.",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "implementationPhases": {
      "type": "array",
      "description": "Ordered sequence of implementation phases. Phase 1 must complete before Phase 2 begins. Epics within the same phase are safe to execute in parallel.",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["phase", "epics", "rationale"],
        "additionalProperties": false,
        "properties": {
          "phase": {
            "type": "integer",
            "minimum": 1,
            "description": "1-based phase number. Lower numbers execute first."
          },
          "epics": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "description": "Epic titles assigned to this phase. Must match epic titles in the epics array exactly."
          },
          "rationale": {
            "type": "string",
            "description": "Why this phase must precede later phases, or why these epics are safe to parallelize."
          }
        }
      }
    }
  },
  "definitions": {
    "moscowPriority": {
      "type": "string",
      "enum": ["Must Have", "Should Have", "Could Have", "Won't Have"]
    },
    "apexPersonaName": {
      "type": "string",
      "description": "Apex groups/roles enum. Treat interview wording 'Super Admin' as Platform Admin.",
      "enum": [
        "Product-Owner",
        "BA",
        "UI/UX",
        "Manager",
        "Developer",
        "QA",
        "Platform Admin",
        "Project Admin",
        "Authenticated User"
      ]
    },
    "personaBehaviors": {
      "type": "array",
      "description": "Optional. Same control/screen with divergent behavior per persona group. Used by design-prototype generation. Features and PBIs only — never on TBIs.",
      "items": {
        "type": "object",
        "required": ["userTypes", "behavior"],
        "additionalProperties": false,
        "properties": {
          "userTypes": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/definitions/apexPersonaName" }
          },
          "behavior": {
            "type": "string",
            "description": "What the control/screen does for this persona group."
          }
        }
      }
    },
    "userTypes": {
      "type": "array",
      "description": "Optional. Apex personas this Feature/PBI serves. Often populated by post-generation enrichment for design prototypes. Features and PBIs only — never on TBIs. Treat Super Admin as Platform Admin.",
      "items": { "$ref": "#/definitions/apexPersonaName" }
    },
    "feature": {
      "type": "object",
      "required": ["id", "title", "priority", "description", "affectedPersonas", "outOfScope", "dependsOn", "items"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^FEAT-[0-9]{3}$",
          "description": "Sequential identifier e.g. FEAT-001. Unique across all features in the backlog."
        },
        "title": { "type": "string" },
        "priority": { "$ref": "#/definitions/moscowPriority" },
        "description": {
          "type": "string",
          "description": "Business narrative naming beneficiaries using affectedPersonas enum names only."
        },
        "affectedPersonas": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/apexPersonaName" }
        },
        "userTypes": { "$ref": "#/definitions/userTypes" },
        "personaBehaviors": { "$ref": "#/definitions/personaBehaviors" },
        "outOfScope": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "dependsOn": {
          "type": "array",
          "items": { "type": "string", "pattern": "^FEAT-[0-9]{3}$" },
          "description": "Feature IDs this feature depends on. Empty array if no dependencies."
        },
        "dependencies": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "Legacy free-text dependency descriptions for human readability."
        },
        "featureFlag": {
          "type": "object",
          "description": "Optional. Include only when the PRD ## Feature Flag section has Flag required: Yes.",
          "required": ["name"],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "description": "Kebab-case flag key matching the PRD."
            }
          }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "$ref": "#/definitions/pbi" },
              { "$ref": "#/definitions/tbi" }
            ]
          }
        }
      }
    },
    "pbi": {
      "type": "object",
      "required": ["type", "id", "title", "priority", "dependsOn", "userStory", "businessRules", "nonFunctionalRequirements", "outOfScope", "acceptanceCriteria"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "const": "PBI" },
        "id": { "type": "string", "pattern": "^PBI-[0-9]{3}$" },
        "title": { "type": "string" },
        "priority": { "$ref": "#/definitions/moscowPriority" },
        "dependsOn": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(PBI|TBI)-[0-9]{3}$" },
          "description": "IDs of PBIs/TBIs within the same Feature only. Cross-Feature relationships must be expressed via feature.dependsOn; shared/foundational work must be extracted into its own earlier-phase Feature. (JSON Schema cannot express this cross-object scope; the constraint is enforced by the /prd-spec-review hard gate.)"
        },
        "parallelGroup": {
          "type": ["string", "null"],
          "description": "Items sharing the same group label are safe to work in parallel."
        },
        "userStory": {
          "type": "object",
          "required": ["persona", "iWant", "soThat"],
          "additionalProperties": false,
          "properties": {
            "persona": { "$ref": "#/definitions/apexPersonaName" },
            "iWant": {
              "type": "string",
              "description": "Verb phrase for the persona's action (completes 'I want to …'). JSON key MUST be iWant (camelCase), never want. Do not include the words 'I want to'. Do not name tables, endpoints, helpers, schemas, or other implementation artifacts — those belong on TBIs."
            },
            "soThat": { "type": "string" }
          }
        },
        "userTypes": { "$ref": "#/definitions/userTypes" },
        "personaBehaviors": { "$ref": "#/definitions/personaBehaviors" },
        "businessRules": {
          "type": "array",
          "items": { "type": "string" }
        },
        "nonFunctionalRequirements": {
          "type": "object",
          "required": ["performance", "accessibility", "security"],
          "additionalProperties": false,
          "properties": {
            "performance": { "type": "string" },
            "accessibility": { "type": "string" },
            "security": { "type": "string" }
          }
        },
        "outOfScope": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "acceptanceCriteria": {
          "type": "array",
          "description": "Must include: (a) happy path, (b) error/failure, (c) edge case/boundary, (d) negative scenario.",
          "minItems": 4,
          "items": {
            "type": "object",
            "required": ["given", "when", "then"],
            "additionalProperties": false,
            "properties": {
              "given": { "type": "string" },
              "when": { "type": "string" },
              "then": { "type": "string" }
            }
          }
        },
        "sizingNote": {
          "type": "string",
          "description": "Present only when AC exceeds 5 items."
        },
        "testCaseCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "tbi": {
      "type": "object",
      "required": ["type", "id", "title", "priority", "dependsOn", "description", "technicalDependencies", "nonFunctionalRequirements", "definitionOfDone"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "const": "TBI" },
        "id": { "type": "string", "pattern": "^TBI-[0-9]{3}$" },
        "title": { "type": "string" },
        "priority": { "$ref": "#/definitions/moscowPriority" },
        "dependsOn": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(PBI|TBI)-[0-9]{3}$" },
          "description": "IDs of PBIs/TBIs within the same Feature only. Cross-Feature relationships must be expressed via feature.dependsOn; shared/foundational work must be extracted into its own earlier-phase Feature. (JSON Schema cannot express this cross-object scope; the constraint is enforced by the /prd-spec-review hard gate.)"
        },
        "parallelGroup": { "type": ["string", "null"] },
        "description": { "type": "string" },
        "technicalDependencies": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "nonFunctionalRequirements": {
          "type": "array",
          "items": { "type": "string" }
        },
        "definitionOfDone": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string" }
        }
      }
    }
  }
}
