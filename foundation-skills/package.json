{
  "name": "@apex/skills",
  "version": "0.1.0",
  "description": "APEX foundation-skill suite: project-agnostic skill foundations plus an installer that vendors foundations and scaffolds pre-filled, per-project adapters.",
  "type": "module",
  "bin": {
    "apex-skills": "bin/apex-skills.mjs"
  },
  "exports": {
    ".": "./lib/index.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "foundation/",
    "adapters/",
    "schemas/",
    "catalog.json",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "validate": "node bin/apex-skills.mjs validate --package ."
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "apex",
    "skills",
    "cursor",
    "foundation",
    "scaffold"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "restricted"
  }
}
