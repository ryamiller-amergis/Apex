{
  "skill": "terraform-infra",
  "scanScope": "targeted",
  "targetedGlobs": [
    "package.json",
    "CONTEXT.md", "context.md", "AGENTS.md",
    "**/*.tf",
    "**/*.tfvars"
  ],
  "ignore": ["node_modules", ".git", "dist", "build", "out", "coverage", ".apex", "__pycache__", "vendor"],
  "detectors": ["stack", "repo-docs"],
  "capFiles": 2000,
  "capMs": 60000,
  "slots": {
    "projectName": { "type": "value", "detector": "stack", "key": "projectName" },
    "contextFile": { "type": "value", "detector": "repo-docs", "key": "contextFile" },
    "agentsFile": { "type": "value", "detector": "repo-docs", "key": "agentsFile" }
  }
}
