{
  "skill": "design-system",
  "scanScope": "targeted",
  "targetedGlobs": [
    "package.json",
    "**/package.json",
    "CONTEXT.md",
    "context.md",
    "CONTEXT-MAP.md",
    "context-map.md",
    "AGENTS.md",
    "agents.md",
    "README.md",
    "readme.md",
    "**/*.css",
    "**/*.scss",
    "**/*.module.css",
    "**/*.module.scss",
    "**/*theme*.ts",
    "**/*Theme*.ts",
    "**/*theme*.tsx",
    "**/*Theme*.tsx",
    "**/*tokens*.ts",
    "**/*Tokens*.ts",
    "**/*globals*.css",
    "**/*variables*.css",
    "**/*variables*.scss",
    "**/*AppShell*",
    "**/*AppBar*",
    "**/*Sidebar*",
    "**/*SideNav*",
    "**/*NavBar*",
    "**/*TopBar*",
    "**/*TopNav*",
    "**/*Header*",
    "**/*Layout*",
    "**/*Navigation*",
    "**/*build-navigation*",
    "**/*nav-config*",
    "**/*navConfig*",
    "**/*nav-items*",
    "**/*menu-items*",
    "**/components/**/*.tsx",
    "**/components/**/*.jsx",
    "**/*.tsx",
    "**/*.jsx"
  ],
  "ignore": ["node_modules", ".git", "dist", "build", "out", "coverage", ".apex", ".next", ".nuxt", "__pycache__", "vendor"],
  "detectors": ["css-variables", "components", "stack", "dir-conventions", "repo-docs", "typography", "app-shell"],
  "capFiles": 3000,
  "capMs": 60000,
  "slots": {
    "projectName": { "type": "value", "detector": "stack", "key": "projectName" },
    "cssTokens": { "type": "list", "detector": "css-variables", "format": "  {key}: {value};", "limit": 100 },
    "components": { "type": "list", "detector": "components", "format": "- {key}", "limit": 150 },
    "dirConventions": { "type": "list", "detector": "dir-conventions", "format": "  - {value}" },
    "contextFile": { "type": "value", "detector": "repo-docs", "key": "contextFile" },
    "agentsFile": { "type": "value", "detector": "repo-docs", "key": "agentsFile" },
    "typographyTokens": { "type": "list", "detector": "typography", "format": "  {key}: {value};", "limit": 30 },
    "navItems": { "type": "list", "detector": "app-shell", "keyPrefix": "nav:", "format": "- {value}", "limit": 20 },
    "shellFiles": { "type": "list", "detector": "app-shell", "keyPrefix": "file:", "format": "  - {value}", "limit": 10 }
  }
}
