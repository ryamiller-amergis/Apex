{
  "skill": "adr-interview",
  "scanScope": "full-repo",
  "ignore": ["node_modules", ".git", "dist", "build", "coverage", ".apex"],
  "detectors": ["stack", "glossary", "dir-conventions"],
  "capFiles": 4000,
  "capMs": 45000,
  "slots": {
    "projectName": { "type": "value", "detector": "stack", "key": "projectName" },
    "glossary": { "type": "table", "detector": "glossary", "columns": ["key", "value"], "limit": 25 }
  }
}
