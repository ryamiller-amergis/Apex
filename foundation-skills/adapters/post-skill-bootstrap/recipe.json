{
  "skill": "post-skill-bootstrap",
  "scanScope": "targeted",
  "targetedGlobs": ["package.json", "AGENTS.md", "agents.md", "CONTEXT.md", "context.md", "CONTEXT-MAP.md", "context-map.md", "README.md", "readme.md", "**/CONTEXT.md", "**/context.md", "**/AGENTS.md", "**/agents.md", "**/CONTEXT-MAP.md", "**/context-map.md", "apex-skills.lock.json"],
  "detectors": ["stack", "repo-docs"],
  "capFiles": 200,
  "capMs": 30000,
  "slots": {
    "projectName": { "type": "value", "detector": "stack", "key": "projectName" },
    "contextFile": { "type": "value", "detector": "repo-docs", "key": "contextFile" },
    "agentsFile": { "type": "value", "detector": "repo-docs", "key": "agentsFile" },
    "skillsDir": { "type": "value", "detector": "repo-docs", "key": "skillsDir" }
  }
}
