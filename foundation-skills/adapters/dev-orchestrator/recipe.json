{
  "skill": "dev-orchestrator",
  "scanScope": "targeted",
  "targetedGlobs": ["package.json", "AGENTS.md", "agents.md", "CONTEXT.md", "context.md", "CONTEXT-MAP.md", "context-map.md", "README.md", "readme.md"],
  "detectors": ["stack", "repo-docs"],
  "capFiles": 100,
  "capMs": 45000,
  "slots": {
    "projectName": { "type": "value", "detector": "stack", "key": "projectName" },
    "contextFile": { "type": "value", "detector": "repo-docs", "key": "contextFile" },
    "agentsFile": { "type": "value", "detector": "repo-docs", "key": "agentsFile" },
    "skillsDir": { "type": "value", "detector": "repo-docs", "key": "skillsDir" }
  }
}
