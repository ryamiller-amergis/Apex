# Azure DevOps Configuration
ADO_ORG=your-organization
ADO_PROJECT=your-project
ADO_PAT=your-personal-access-token
ADO_AREA_PATH=your-area-path

# Azure AD Authentication (see docs/AUTHENTICATION_SETUP.md)
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_REDIRECT_URL=http://localhost:3001/auth/callback
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-random-secret

# Cursor API (agents / Ask Apex). Optional for basic UI smoke tests.
CURSOR_API_KEY=
# Cursor Admin / team billing (AI Cost Analytics sync). Required for Cursor
# billed dollars; without it Cursor costs stay estimated at $0.
CURSOR_TEAM_API_KEY=
# Apex agent service account ID — keeps Cursor billing Apex-only (recommended).
# Without it, allocation falls back to isHeadless=true rows only.
CURSOR_SERVICE_ACCOUNT_ID=

# Design-system / EXTEND-mode source repo (used to fetch existing-page context for
# design prototypes). Defaults to "MaxView".
MAXVIEW_DS_REPO=MaxView
MAXVIEW_DS_PROJECT=MaxView
# Repo-relative root the screen inventory's "Component / File" paths are listed under.
# The MaxView ClientApp lives below the repo root, so its inventory paths (e.g.
# `components/...`) must be rooted here to resolve to real files. Leave unset when the
# inventory uses repo-root-relative paths.
MAXVIEW_CLIENTAPP_ROOT=/src/Maxim.TimeClock.Web/ClientApp/js

# Server Configuration
PORT=3001

# Polling interval in seconds (default: 30)
POLL_INTERVAL=30

# AWS Bedrock Configuration
AWS_REGION=us-east-1
# Cost Explorer region (global CE API is served from us-east-1)
AWS_CE_REGION=us-east-1
# IAM principal cost-allocation tag on the Apex Bedrock-calling role.
# Activate "Application" in Billing → Cost allocation tags, then Sync Now.
BEDROCK_COST_TAG_KEY=Application
BEDROCK_COST_TAG_VALUE=Apex
# Default model used for backlog generation (Features, PBIs, clarifications, etc.)
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Model used specifically for UI/UX mock generation (vision + HTML).
# Falls back to BEDROCK_MODEL_ID if unset. Opus 4.7 produces the best visual
# fidelity for design prototype generation.
BEDROCK_UI_MOCK_MODEL_ID=us.anthropic.claude-opus-4-7
# Max output tokens for UI mock generation. UI mocks can be large HTML+JSON
# documents — Opus 4.7 often needs 20K-30K tokens for detailed prototypes.
BEDROCK_UI_MOCK_MAX_TOKENS=32000

# PostgreSQL Database
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=require
# - Production: set automatically by Terraform (injected into App Service app_settings)
# - Local dev: point to a local PostgreSQL instance (conventional DB name: aipilot)
#   or use a tunnel / shared cloud DATABASE_URL from the team env files
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/aipilot

# E2E test database (Playwright) — MUST be a separate database from DATABASE_URL
# so browser tests never touch real data. If left unset, the Playwright config
# derives one by appending "_e2e" to the DATABASE_URL database name.
# Create it once: psql -U pgadmin -h localhost -c "CREATE DATABASE aipilot_e2e;"
TEST_DATABASE_URL=postgresql://pgadmin:Amergis123!@localhost:5432/aipilot_e2e

# Deployed-smoke targeting (Playwright `deployed-smoke` project) — read-only
# smoke against an already-running deployment. Leave BOTH unset for the normal
# local full suite (Playwright manages its own servers on 127.0.0.1:3000).
#   E2E_BASE_URL      Base URL of the deployed site to smoke-test. Setting this
#                     switches Playwright into deployed-target mode: no local
#                     webServer, no migrations/seeding, and enables the
#                     `deployed-smoke` project. Examples:
#                       dev     https://app-scrum-dev.azurewebsites.net
#                       staging https://app-apex-prd-staging.azurewebsites.net
#                       prod    https://app-apex-prd.azurewebsites.net
#   E2E_STORAGE_STATE Path to a pre-captured SSO storageState JSON (staging/prod,
#                     or any NODE_ENV=production deployment where /auth/dev-login
#                     is gated off). Capture it once with
#                     `npm run test:e2e:auth:capture`. NEVER commit this file.
E2E_BASE_URL=
E2E_STORAGE_STATE=

# Agent token signing secret — used to mint short-lived HMAC tokens that
# authorize the Cursor agent to fetch the mock HTML and post the resulting
# Figma URL back. REQUIRED in production (otherwise the server falls back to
# an insecure dev-only secret and logs a warning). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKLOG_AGENT_SIGNING_SECRET=replace-with-32-byte-random-hex

# Azure Application Insights
# Set automatically by Terraform in production; leave empty for local dev.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# PDF artifact storage and in-app Postgres job queue.
# Leave PDF_BLOB_ACCOUNT_NAME empty for the local-disk backend.
PDF_BLOB_ACCOUNT_NAME=
PDF_BLOB_CONTAINER_NAME=pdf-artifacts
PDF_MAX_CONCURRENT_JOBS=40
PDF_MAX_CONCURRENT_JOBS_PER_INSTANCE=7
PDF_MAX_CONCURRENT_JOBS_PER_USER=3
PDF_MAX_QUEUED_JOBS_PER_USER=12
PDF_MAX_QUEUE_DEPTH=200
# Lease must exceed DOCX_CONVERSION_TIMEOUT_MS (default 15 minutes).
PDF_JOB_LEASE_MS=1200000
PDF_JOB_HEARTBEAT_MS=30000
PDF_JOB_POLL_INTERVAL_MS=1000

# SendGrid (Twilio) — used by the sendgrid MCP server for email analytics.
# Generate a read-only key at https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=

# ── APEX Foundation Skills Distribution ────────────────────────────────────────
# Controls the @apex/skills release management features (Platform Admin > APEX Skills).
# All vars are optional: omit them to use the APEX UI in read-only / no-feed mode.
#
# AZURE_ARTIFACTS_ORG     — Azure DevOps org that hosts the feed (e.g. "amergis")
# AZURE_ARTIFACTS_PROJECT — ADO project containing the feed; leave empty for
#                           org-scoped feeds (most common for npm packages)
# AZURE_ARTIFACTS_FEED    — Feed name (e.g. "apex-skills")
# AZURE_ARTIFACTS_PAT     — Personal Access Token with Packaging Read+Write scope
#
# Provisioning (one-time human steps — not done by the agent):
#   1. Create an Azure Artifacts feed named AZURE_ARTIFACTS_FEED in your ADO org.
#   2. Add a "Local" and a "Release" view to the feed.
#   3. Create a PAT and set it below.
#   4. Add the feed scope to this app's App Service configuration via Terraform or
#      the Azure portal (the CI workflow reads secrets from GitHub Actions secrets).
AZURE_ARTIFACTS_ORG=
AZURE_ARTIFACTS_PROJECT=
AZURE_ARTIFACTS_FEED=apex-skills
AZURE_ARTIFACTS_PAT=

# APEX project name — used by the UI Lab to detect when requests are for the APEX
# project itself (which generates APEX-styled output instead of MaxView-styled).
# Defaults to "Apex" when unset.  Must match the project name shown in the APEX
# project selector (case-insensitive comparison).
APEX_PROJECT_NAME=Apex

# MaxView timecard-debug MCP (read-only). When configured AND the `maxview-mcp`
# feature flag is enabled for the user/project, the chat agent gets the MaxView
# timecard tools via the Apex-hosted proxy at /mcp/maxview. Apex logs in with the
# service account below and auto-refreshes the RS256 app token. The service
# account must have the MaxView-side `mcp-server` feature flag enabled.
MAXVIEW_MCP_BASE_URL=
MAXVIEW_MCP_USERNAME=
MAXVIEW_MCP_PASSWORD=
# Optional: supply a pre-minted bearer token instead of username/password
# (bypasses the login flow; note the token expires and is not auto-refreshed).
MAXVIEW_MCP_TOKEN=
# Optional: set to "true" to skip TLS cert validation for a local self-signed
# MaxView dev server (e.g. https://localhost:5001). NEVER enable in production.
MAXVIEW_MCP_INSECURE_TLS=
