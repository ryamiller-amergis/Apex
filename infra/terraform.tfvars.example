# IMPORTANT: Do not commit this file with real values!
# Copy this to terraform.tfvars and fill in your actual values

resource_group_name    = "rg-ai-pilot-dev"
location               = "East US"
app_service_name       = "app-ai-pilot-dev"
app_service_plan_name  = "plan-ai-pilot-dev"
app_service_plan_sku   = "B1" # Use S1+ in prod for deployment slots (blue-green)
environment            = "dev"

# Azure DevOps Configuration
ado_org     = "https://dev.azure.com/your-org"
ado_pat     = "your-pat-token-here"
ado_project = "YourProject"

# Optional: Override default tags
# tags = {
#   ManagedBy   = "Terraform"
#   Application = "AI-Pilot"
#   Team        = "Platform"
#   CostCenter  = "Engineering"
# }

# Azure AD Auth — use the SAME app registration as GitHub AZURE_CREDENTIALS
# (deployment SP and user sign-in share one app; redirect URIs must include /auth/callback)
azure_tenant_id     = "your-tenant-id"
azure_client_id     = "your-client-id"
azure_client_secret = "your-client-secret"
azure_redirect_url  = "https://your-app.azurewebsites.net/auth/callback"
session_secret      = "your-session-secret"

# Azure Cost Management
azure_cost_tenant_id     = "your-tenant-id"
azure_cost_client_id     = "your-cost-client-id"
azure_cost_client_secret = "your-cost-client-secret"

# AWS Bedrock
aws_access_key_id     = "your-aws-key-id"
aws_secret_access_key = "your-aws-secret"
aws_region            = "us-east-2"
bedrock_model_id      = "us.anthropic.claude-haiku-4-5-20251001-v1:0"

# Cursor
cursor_api_key      = "crsr_..."
cursor_team_api_key = "crsr_..."

# Application
ado_area_path        = "YourProject"
ado_allowed_projects = "YourProject,AnotherProject"
vite_teams           = "YourProject|YourProject"
poll_interval        = "30"
port                 = "8080"

# PostgreSQL Database Configuration
postgresql_server_name    = "psql-hub-dev"
postgresql_admin_username = "pgadmin"
postgresql_admin_password = "ChangeMe123!"  # Must include upper, lower, number, min 8 chars
postgresql_database_name  = "aipilot"
postgresql_sku_name       = "B_Standard_B1ms"

# Shared async Blob platform
# One private storage account per environment. Add containers for new modules.
# PDF job delivery uses the Postgres queue (revised ADR) — Service Bus is not
# provisioned until scale-up triggers require a managed broker.
# Null uses the standard stapex<environment>async name (for example,
# stapexdevasync or stapexprdasync). Override only for a global-name collision.
shared_storage_account_name = null
# blob_containers default includes pdf-artifacts. Example for another module:
# blob_containers = {
#   pdf-artifacts      = {}
#   standup-recordings = {}
# }

pdf_blob_container_name = "pdf-artifacts"

# ---------------------------------------------------------------------------
# Load Test module — FEAT-002
# Resource names follow the Apex convention {type}-apex-lt-{environment}.
# Null values derive the standard name automatically:
#   sbns-apex-lt-dev  sbns-apex-lt-prd   Service Bus namespace
#   cae-apex-lt-dev   cae-apex-lt-prd    Container Apps Environment
#   caj-apex-lt-dev   caj-apex-lt-prd    Container Apps Job
#   mi-apex-lt-runner-dev  mi-apex-lt-runner-prd  Runner managed identity
#   lt-artifacts                          Blob container (all environments)
# Override only for global-name collisions or multi-region deployments.
# ---------------------------------------------------------------------------

# lt_servicebus_namespace_name = null   # derives "sbns-apex-lt-dev"
# lt_servicebus_queue_name     = null   # derives "lt-dispatch"
# lt_container_app_env_name    = null   # derives "cae-apex-lt-dev"
# lt_container_app_job_name    = null   # derives "caj-apex-lt-dev"
# lt_runner_identity_name      = null   # derives "mi-apex-lt-runner-dev"
# lt_blob_container_name       = null   # derives "lt-artifacts"

# Platform concurrency cap (1–2; default 2 per PRD guardrail).
# lt_max_executions = 2

# Runner image — update to pinned ACR digest after Lane B (image build) completes.
# Format: <acr>.azurecr.io/apex-lt-runner:<tag>@sha256:<digest>
# lt_runner_image = "grafana/k6:latest"  # placeholder until CI publishes apex-lt-k6
# lt_acr_name = null                     # derives acrapexlt{environment}
# Grant GitHub Actions deploy SP AcrPush (object ID):
# lt_acr_push_principal_ids = ["00000000-0000-0000-0000-000000000000"]
# Disable if the apply principal cannot manage staging-slot RBAC or staging
# load-test dispatch is not required:
# lt_enable_staging_slot_rbac = false

# VNet subnet for runner egress to non-prod targets (A-007).
# Required before load tests can reach VNet-peered allowlisted hosts.
# lt_vnet_subnet_id = "/subscriptions/.../subnets/snet-apex-lt-dev"

# Key Vault for target auth secret injection at runner execution time.
# lt_key_vault_id = "/subscriptions/.../vaults/kv-apex-dev"

# Apex API callback URL (fallback on the Container Apps Job; dispatch message
# callbackBaseUrl from the API takes precedence).
# Dev:  https://app-scrum-dev.azurewebsites.net
# Prod: https://app-apex-prd.azurewebsites.net
# lt_apex_callback_base_url = "https://app-scrum-dev.azurewebsites.net"
#
# Short-term runner ingest auth (shared bearer). Prefer GitHub secret
# LT_RUNNER_CALLBACK_TOKEN for App Service; optionally set here for the job:
# lt_runner_callback_token = "generate-a-long-random-string"
#
# Long-term MI path (requires Graph Application.ReadWrite.* on apply identity):
# lt_enable_entra_ingest_app = true
# lt_callback_token_audience = null   # → api://apex-lt-ingest-{environment}
#
# App Service sticky callback host (via deploy pipeline):
#   LT_APEX_CALLBACK_BASE_URL = staging host vs prod host per slot

# ---------------------------------------------------------------------------
# AI Runs background worker — FEAT-003
# Shared Service Bus namespace (not the load-test sbns-apex-lt-* namespace).
# KEDA max_executions and AI_RUNS_BACKGROUND_INFLIGHT_LIMIT share one value.
# ---------------------------------------------------------------------------

# ai_runs_servicebus_namespace_name = null  # derives "sbns-apex-ai-dev"
# ai_runs_background_queue_name     = null  # derives "ai-runs-background"
# ai_runs_container_app_env_name    = null  # derives "cae-apex-ai-dev"
# ai_runs_container_app_job_name    = null  # derives "caj-apex-ai-runs-dev"
# ai_runs_runner_identity_name      = null  # derives "mi-apex-ai-runs-runner-dev"
# ai_runs_max_in_flight             = 10    # must match App Service AI_RUNS_BACKGROUND_INFLIGHT_LIMIT
# ai_runs_file_share_name           = null  # derives "ai-pilot-data"
# ai_runs_workspace_mount_path      = "/home/data/ai-pilot/workspaces"
# ai_runs_vnet_subnet_id            = null
# ai_runs_key_vault_name            = null  # derives "kv-apex-ai-{environment}" and seeds cursor-api-key
# To use an existing vault instead, set both:
# ai_runs_key_vault_id              = "/subscriptions/.../vaults/kv-apex-dev"
# ai_runs_cursor_api_key_secret_id  = "https://kv-apex-dev.vault.azure.net/secrets/cursor-api-key/<version>"
# ai_runs_runner_image              = "<acr>.azurecr.io/apex-ai-runs:<tag>"  # CI publishes; TF ignores image drift
# enable_ai_runs_entra_app          = false
# ai_runs_runner_callback_token     = null  # short-term ingest fallback
# ai_runs_apex_callback_base_url    = "https://app-scrum-dev.azurewebsites.net"

# ---------------------------------------------------------------------------
# AI Runs interactive lane — FEAT-007 (WebSocket gateway + Dapr virtual actors)
# Additive/inert while disabled. Reuses the FEAT-003 ai-runs Container Apps
# Environment, runner managed identity, Azure Files workspace, LT ACR, and the
# Cursor API key secret. Provisions ONLY a warm ACA app (Dapr actor host + WS
# gateway) + an Azure Cache for Redis backplane — NO Service Bus queue.
#
# Reserved/burst/SLO here MUST match the App Service env vars of the same name
# (AI_RUNS_INTERACTIVE_RESERVED / _BURST_MAX / _FIRST_TOKEN_SLO_MS) so the actor
# tier and the in-process admission governor agree on capacity (BR-014).
# ---------------------------------------------------------------------------

# Master switch. Keep false until the `ai-runs-interactive` DB feature flag and
# the App Service AI_RUNS_INTERACTIVE_GATEWAY flag are ready to roll out.
# enable_ai_runs_interactive = false

# Names — null derives the standard {type}-apex-ai-{environment} convention:
#   ca-apex-ai-interactive-dev / -prd   Container App (actor host + WS gateway)
#   redis-apex-ai-dev / -prd             Azure Cache for Redis backplane
# ai_runs_interactive_container_app_name = null
# ai_runs_interactive_redis_name         = null
# ai_runs_interactive_redis_location     = null # defaults to App Service region

# Preserve existing dev caches with "cache". Use "managed" for new environments;
# Azure no longer accepts new Azure Cache for Redis instances. Balanced_B0 is
# the smallest Azure Managed Redis tier; enable HA for production.
# ai_runs_interactive_redis_backend = "cache"
# ai_runs_interactive_redis_sku      = "Basic"     # prod: "Standard"
# ai_runs_interactive_redis_family   = "C"
# ai_runs_interactive_redis_capacity = 0            # prod: 1+
# ai_runs_interactive_managed_redis_sku               = "Balanced_B0"
# ai_runs_interactive_managed_redis_high_availability = false # prod: true

# Clustering policy for Azure Managed Redis. Defaults to EnterpriseCluster (a
# single logical endpoint) so the standalone ioredis live bus and Dapr
# non-cluster clients work. DO NOT set OSSCluster unless every consumer speaks
# the OSS Cluster protocol — it silently breaks classic pub/sub fan-out across
# shards, stalling the interactive live token stream, and risks Dapr actor-state
# MOVED/CROSSSLOT if scaled.
# NOTE: immutable on an existing DB — changing it replaces the Managed Redis.
# create_before_destroy avoids downtime, but a new instance requires a DISTINCT
# ai_runs_interactive_redis_name (e.g. redis-apex-ai-prd-v2). After apply,
# redeploy the App Service so deploy.yml re-resolves REDIS_* to the new instance.
# The backplane holds no durable data (durability is in Postgres).
# ai_runs_interactive_managed_redis_clustering_policy = "EnterpriseCluster"

# Interactive host image — placeholder until CI publishes the Dapr actor-host
# image; Terraform ignores image drift (lifecycle ignore_changes). Point at the
# LT ACR repo once the host Dockerfile + publish step land.
# ai_runs_interactive_image  = "<acr>.azurecr.io/apex-ai-interactive:<tag>"
# ai_runs_interactive_cpu    = 2.0
# ai_runs_interactive_memory = "4Gi"
# ai_runs_interactive_target_port = 8080

# Warm capacity. reserved = ACA min_replicas (no scale-to-zero); max_replicas =
# reserved + burst_max. Shed to in-process above burst (never queues).
# ai_runs_interactive_reserved  = 4     # prod: size to steady-state concurrency
# ai_runs_interactive_burst_max = 12

# First-token P95 SLO (ms) gating the interactive latency alert. Confirm with
# product before enforcing.
# ai_runs_interactive_first_token_slo_ms = 1500

# ---------------------------------------------------------------------------
# Async repository checkout worker (queue on existing sbns-apex-ai-*)
# max_executions is hardcoded to 1. Image updates from CI are ignored by TF.
# ---------------------------------------------------------------------------
# repo_checkout_queue_name              = null  # derives "repo-checkout"
# repo_checkout_container_app_job_name  = null  # derives "caj-apex-repo-checkout-{environment}"
# repo_checkout_runner_identity_name    = null  # derives "mi-apex-repo-checkout-{environment}"
# repo_checkout_runner_image            = "<acr>.azurecr.io/apex-repo-checkout:<tag>"
# github_org                            = null  # optional Job GITHUB_ORG
# github_token                          = null  # optional; do not commit real tokens


