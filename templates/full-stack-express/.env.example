# API
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://app_user:local-dev-only-password@localhost:5432/project_db
AUTH_MODE=development
# JSON object of kebab-case flag names to booleans. Wrap a non-empty value in
# single quotes, for example FEATURE_FLAGS='{"checkout-v2":true}'.
FEATURE_FLAGS={}
SHUTDOWN_TIMEOUT_MS=25000
# /health/ready answers 503 after this many milliseconds (100 to 10000). Set
# the orchestrator's probe timeout higher than this value.
READINESS_TIMEOUT_MS=2000
# Requests per client IP per window on /api. Empty means no limit. Health
# probes are never limited.
RATE_LIMIT_MAX=
RATE_LIMIT_WINDOW_MS=60000
# Built web client served for non-API paths, for example ../web/dist. Empty
# means the API serves no static files.
CLIENT_DIST_DIR=

# API telemetry. No endpoint and no console exporter means telemetry stays off.
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=project-service
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_TIMEOUT=
OTEL_TRACES_EXPORTER=
OTEL_METRICS_EXPORTER=
OTEL_METRIC_EXPORT_INTERVAL=
OTEL_BSP_SCHEDULE_DELAY=

# Web build-time
VITE_APP_NAME=project-name
VITE_API_BASE_URL=

# Local PostgreSQL (Compose)
POSTGRES_USER=app_user
POSTGRES_PASSWORD=local-dev-only-password
POSTGRES_DB=project_db
POSTGRES_PORT=5432
