# API
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://app_user:local-dev-only-password@localhost:5432/project_db
AUTH_MODE=development
SHUTDOWN_TIMEOUT_MS=25000

# API telemetry. No endpoint and no console exporter means telemetry stays off.
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=project-service
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_TIMEOUT=
OTEL_TRACES_EXPORTER=
OTEL_METRICS_EXPORTER=
OTEL_METRIC_EXPORT_INTERVAL=
OTEL_BSP_SCHEDULE_DELAY=

# Web build-time
VITE_APP_NAME=project-name
VITE_API_BASE_URL=

# Local PostgreSQL (Compose)
POSTGRES_USER=app_user
POSTGRES_PASSWORD=local-dev-only-password
POSTGRES_DB=project_db
POSTGRES_PORT=5432
