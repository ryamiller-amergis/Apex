        "operationId": "getHealthReady",
        "summary": "Readiness probe",
        "description": "Returns 200 when dependencies are reachable and 503 otherwise. The 503 body names no host, connection string, or error text.",
        "responses": {
          "200": {
            "description": "The service is ready",
            "headers": {
