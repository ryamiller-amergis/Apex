  "components": {
    "headers": {
      "X-Request-Id": {
        "description": "Correlates the response with server log lines.",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      }
    },
    "schemas": {
      "AnalyzeInsightsBody": {
        "type": "object",
        "properties": {
          "focusArea": {
            "type": "string",
            "enum": ["operations", "retention", "capacity"]
          },
          "includeConnectorFeed": {
            "type": "boolean"
          },
          "connectorSource": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "additionalProperties": false,
        "description": "Parameters for invoking the grounded AI skill over database records and connector feeds."
      },
      "CreateNotificationBody": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "category": {
            "type": "string",
            "enum": ["system", "workflow", "insight", "alert"]
          }
        },
        "required": ["title", "message"],
        "additionalProperties": false,
        "description": "Creates a new notification for the authenticated principal."
      },
      "HealthLive": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          }
        },
        "required": ["status"],
        "additionalProperties": false
      },
      "HealthReady": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ready"
          }
        },
        "required": ["status"],
        "additionalProperties": false
      },
      "InsightCitation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "sourceKind": {
            "type": "string",
            "enum": ["database", "connector"]
          },
          "sourceLabel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "excerpt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        },
        "required": ["id", "sourceKind", "sourceLabel", "excerpt"],
        "additionalProperties": false,
        "description": "Grounding citation referencing a database record or a third-party connector feed item."
      },
      "InsightFinding": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "impact": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "recommendedAction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "citationIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        },
        "required": [
          "id",
          "title",
          "summary",
          "impact",
          "recommendedAction",
          "citationIds"
        ],
        "additionalProperties": false,
        "description": "One structured AI skill finding with recommended action."
      },
      "InsightsAnalysis": {
        "type": "object",
        "properties": {
          "skillName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "modelId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "focusArea": {
            "type": "string",
            "enum": ["operations", "retention", "capacity"]
          },
          "headline": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "findings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InsightFinding"
            }
          },
          "citations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InsightCitation"
            }
          }
        },
        "required": [
          "skillName",
          "modelId",
          "focusArea",
          "headline",
          "findings",
          "citations"
        ],
        "additionalProperties": false,
        "description": "Grounded analysis produced by the AI skill adapter over database and connector sources."
      },
      "MarkNotificationReadBody": {
        "type": "object",
        "properties": {
          "notificationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "markAll": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "description": "Marks one notification or all notifications as read for the caller."
      },
      "NotificationItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "category": {
            "type": "string",
            "enum": ["system", "workflow", "insight", "alert"]
          },
          "read": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "required": ["id", "title", "message", "category", "read", "createdAt"],
        "additionalProperties": false,
        "description": "One in-app notification for the authenticated principal."
      },
      "NotificationsList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NotificationItem"
            }
          },
          "unreadCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["items", "unreadCount"],
        "additionalProperties": false,
        "description": "Notifications and unread badge count for the caller."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "urn:problem-type:validation-error",
              "urn:problem-type:malformed-body",
              "urn:problem-type:authentication-required",
              "urn:problem-type:not-found",
              "urn:problem-type:rate-limited",
              "urn:problem-type:not-ready",
              "urn:problem-type:internal-error",
              "urn:problem-type:service-unavailable",
              "urn:problem-type:payload-too-large"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "pointer": {
                  "type": "string"
                },
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "message": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["pointer", "code", "message"],
              "additionalProperties": false
            }
          }
        },
        "required": ["type", "title", "status", "requestId"],
        "additionalProperties": false,
        "description": "RFC 9457 Problem Details. Never carries identity values."
      },
      "Profile": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "email": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 254,
                "format": "email",
                "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": ["active", "disabled"]
          }
        },
        "required": ["displayName", "email", "status"],
        "additionalProperties": false,
        "description": "The profile of the caller. Never includes the subject."
      },
      "UpdateProfileBody": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "email": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 254,
                "format": "email",
                "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["displayName"],
        "additionalProperties": false,
        "description": "Replaces both editable fields. Both are trimmed. An omitted, null, or blank email clears it."
      }
    },
    "securitySchemes": {
      "principal": {
        "type": "http",
        "scheme": "bearer",
        "description": "Placeholder. The identity-provider adapter decides how the principal is sent."
      }
    }
  }
}
