{
  "openapi": "3.1.0",
  "info": {
    "title": "project-name API",
    "version": "0.1.0",
    "description": "Generated from the Zod route definitions. Do not edit by hand."
  },
  "paths": {
    "/api/v1/insights/analyze": {
      "post": {
        "operationId": "analyzeInsights",
        "summary": "Run grounded AI skill analysis over database and connector data",
        "description": "Invokes the structured AI skill adapter (configured with composer-2.5 by default) over database records and the third-party connector feed.",
        "security": [
          {
            "principal": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeInsightsBody"
              },
              "example": {
                "focusArea": "operations",
                "includeConnectorFeed": true,
                "connectorSource": "Logistics Telemetry Feed"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Grounded insights, citations, and recommended actions",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/X-Request-Id"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InsightsAnalysis"
                },
                "example": {
                  "skillName": "operational-briefing",
                  "modelId": "composer-2.5",
                  "focusArea": "operations",
                  "headline": "Fulfillment throughput rose 14% while connector telemetry flagged two regional carrier delays.",
                  "findings": [
                    {
                      "id": "finding-carrier-delay",
                      "title": "Rebalance Midwest carrier dispatch window",
                      "summary": "Database order cycle logs and carrier webhook telemetry show a 35-minute pickup lag on afternoon routes.",
                      "impact": "high",
                      "recommendedAction": "Shift priority Midwest dispatches to the 13:30 cutoff and notify warehouse leads.",
                      "citationIds": ["cit-db-orders", "cit-conn-carrier"]
                    }
                  ],
                  "citations": [
                    {
                      "id": "cit-db-orders",
                      "sourceKind": "database",
                      "sourceLabel": "Database · Fulfillment Ledger Q1",
                      "excerpt": "42 priority batches completed with 98.4% on-time verification across primary hubs."
                    },
                    {
                      "id": "cit-conn-carrier",
                      "sourceKind": "connector",
                      "sourceLabel": "Connector · Logistics Telemetry Feed",
                      "excerpt": "Regional hub ORD-2 reported a 35-minute dock queue spike between 14:00 and 16:00."
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "The request failed validation or the body was malformed",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/X-Request-Id"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Authentication is required",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/X-Request-Id"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/X-Request-Id"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/X-Request-Id"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "The analysis service or database is unavailable.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/X-Request-Id"
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
